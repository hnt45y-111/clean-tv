<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <application
        android:label="قنواتي"
        android:icon="@drawable/ic_app_cinema"
        android:usesCleartextTraffic="true"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout"
            android:windowSoftInputMode="adjustResize">
            <!-- «مشاركة» رابط من أي تطبيق -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- روابط البث وقوائم التشغيل فقط (مو كل روابط الإنترنت) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" /><data android:scheme="https" />
                <data android:mimeType="application/x-mpegurl" /><data android:mimeType="application/vnd.apple.mpegurl" /><data android:mimeType="audio/x-mpegurl" /><data android:mimeType="video/*" />
            </intent-filter>
        </activity>
        <activity-alias android:name=".IconCinema" android:targetActivity=".MainActivity" android:exported="true" android:enabled="true" android:icon="@drawable/ic_app_cinema" android:label="قنواتي">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".IconRoyal" android:targetActivity=".MainActivity" android:exported="true" android:enabled="false" android:icon="@drawable/ic_app_royal" android:label="قنواتي">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".IconKarbala" android:targetActivity=".MainActivity" android:exported="true" android:enabled="false" android:icon="@drawable/ic_app_karbala" android:label="قنواتي">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".IconAlawi" android:targetActivity=".MainActivity" android:exported="true" android:enabled="false" android:icon="@drawable/ic_app_alawi" android:label="قنواتي">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".IconApple" android:targetActivity=".MainActivity" android:exported="true" android:enabled="false" android:icon="@drawable/ic_app_apple" android:label="قنواتي">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".IconNeon" android:targetActivity=".MainActivity" android:exported="true" android:enabled="false" android:icon="@drawable/ic_app_neon" android:label="قنواتي">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity android:name=".SiteActivity" android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".PlayerActivity" android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:supportsPictureInPicture="true"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout"
            android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen" />
        <!-- MSM-WIDGETS:BEGIN -->
        <receiver android:name="com.cleantv.mobile.wd.MobileWidgets$Resume" android:exported="true" android:label="كمّل المشاهدة">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/wd_resume" />
        </receiver>
        <receiver android:name="com.cleantv.mobile.wd.MobileWidgets$Favs" android:exported="true" android:label="مفضلتي">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/wd_favs" />
        </receiver>
        <receiver android:name="com.cleantv.mobile.wd.MobileWidgets$Grid" android:exported="true" android:label="اختصاراتي">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/wd_grid" />
        </receiver>
        <receiver android:name="com.cleantv.mobile.wd.MobileWidgets$Nav" android:exported="true" android:label="شريط سريع">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/wd_nav" />
        </receiver>
        <receiver android:name="com.cleantv.mobile.wd.MobileWidgets$Clock" android:exported="true" android:label="ساعة وتحية">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/wd_clock" />
        </receiver>
        <receiver android:name="com.cleantv.mobile.wd.MobileWidgets$Movies" android:exported="true" android:label="الأفلام">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/wd_movies" />
        </receiver>
        <receiver android:name="com.cleantv.mobile.wd.MobileWidgets$Quiet" android:exported="true" android:label="وضع الهدوء">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/wd_quiet" />
        </receiver>
        <activity android:name="com.msm.widgets.PickActivity" android:exported="true" android:excludeFromRecents="true" android:theme="@android:style/Theme.Material.NoActionBar">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" /></intent-filter>
            <meta-data android:name="msm.app" android:value="com.cleantv.mobile.wd.MobileWidgets" />
        </activity>
        <activity android:name="com.msm.widgets.ActActivity" android:exported="false" android:excludeFromRecents="true" android:theme="@android:style/Theme.NoDisplay">
            <meta-data android:name="msm.app" android:value="com.cleantv.mobile.wd.MobileWidgets" />
        </activity>
        <!-- MSM-WIDGETS:END -->
    </application>
</manifest>
