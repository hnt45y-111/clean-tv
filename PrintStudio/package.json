{
  "name": "print-studio",
  "version": "1.0.0",
  "description": "Print Studio — مركز الطباعة والسكانر والتعرف الذكي على الملفات",
  "main": "src/main/main.js",
  "private": true,
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "dist": "node tools/vendor.js && electron-builder --win nsis",
    "vendor": "node tools/vendor.js",
    "postinstall": "node tools/vendor.js",
    "e2e": "node tests/e2e/scan-export.js && node tests/e2e/ocr-flows.js && node tests/e2e/ids-settings-pdf-archive-print.js"
  },
  "build": {
    "appId": "com.printstudio.app",
    "productName": "Print Studio",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "node_modules/**/*",
      "!node_modules/electron/**",
      "!node_modules/electron-builder/**"
    ],
    "extraResources": [
      {
        "from": "assets/tessdata",
        "to": "tessdata"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "language": "1025",
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "Print Studio"
    },
    "asarUnpack": [
      "node_modules/sharp/**",
      "node_modules/@img/**",
      "node_modules/tesseract.js-core/**"
    ]
  },
  "dependencies": {
    "@fontsource/noto-sans-arabic": "^5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@tesseract.js-data/ara": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "docx": "^9.16.1",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "sharp": "^0.35.5",
    "sql.js": "^1.17.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0"
  }
}